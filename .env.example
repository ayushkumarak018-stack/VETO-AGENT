# ==============================================================================
# VETO AGENT Configuration
# ==============================================================================

# Application Base URL
APP_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database Configuration (SQLite default for seamless zero-dependency local dev; PostgreSQL supported)
DATABASE_URL="file:./dev.db"

# Session Security (JWT secret for application user sessions)
JWT_SECRET="veto_agent_super_secret_jwt_key_minimum_32_characters_long_for_security"

# ==============================================================================
# TOKEN VAULT (CRITICAL SECURITY)
# ==============================================================================
# AES-256-GCM 32-byte Encryption Key (64 hex characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_VAULT_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# ==============================================================================
# GOOGLE CALENDAR OAUTH 2.0 INTEGRATION
# ==============================================================================
# Optional in DEMO mode; required for live Google Calendar operations
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/integrations/google/callback"

# ==============================================================================
# CIBA (CLIENT-INITIATED BACKCHANNEL AUTHENTICATION)
# ==============================================================================
# Optional in DEMO mode; configured for standard OpenID CIBA providers
CIBA_ISSUER=""
CIBA_CLIENT_ID=""
CIBA_CLIENT_SECRET=""
CIBA_AUTH_ENDPOINT=""
CIBA_TOKEN_ENDPOINT=""
CIBA_POLLING_INTERVAL_SECONDS="3"

# ==============================================================================
# OUT-OF-BAND NOTIFICATIONS (EMAIL / PUSH)
# ==============================================================================
# Optional: Resend API key for real out-of-band emails
RESEND_API_KEY=""
NOTIFICATION_EMAIL_FROM="Veto Agent Security <approvals@veto-agent.local>"

# ==============================================================================
# AI ENGINE CONFIGURATION
# ==============================================================================
# Google Gemini API key (optional; deterministic AI fallback works automatically if unset)
GEMINI_API_KEY=""

# Optional Auth0 Integration
AUTH0_DOMAIN=""
AUTH0_CLIENT_ID=""
AUTH0_CLIENT_SECRET=""

# Demo / Development Mode Toggle
# When true, realistic mock calendar data and local out-of-band approval previews are active
DEMO_MODE="true"

